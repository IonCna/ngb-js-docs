{
  "version": "1",
  "root": ".",
  "projectType": "library",
  "sourceRoot": "src",
  "prefix": "app",
  "architect": {
    "build": {
      "options": {
        "entryPoints": {
          "index": "src/index.ts"
        },
        "styles": [
          { "input": "node_modules/bootstrap/dist/css/bootstrap.min.css" },
          { "input": "node_modules/bootstrap-icons/font/bootstrap-icons.css" },
          { "input": "src/style.css" }
        ],
        "outputPath": "dist"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "src/environments/environment.ts",
              "with": "src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "test": {
      "options": {
        "include": [
          "src/**/*.spec.ts"
        ]
      }
    }
  }
}
